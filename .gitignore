# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
# Exception: the stock Android debug keystore (alias androiddebugkey, self-signed
# CN=Android Debug). Tracked so every clone shares one debug SHA-1, which the
# Google Sign-In Android OAuth client is registered against. Never a release key.
!android/app/debug.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios

# Android: the native project is tracked so customisations survive a fresh
# clone. Generated, machine-local and signing files stay ignored.
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/app/.cxx/
android/.idea/
android/*.iml
android/app/src/main/java/inline/
*.jsbundle

# local docs (phase documentation PDFs — not part of the app)
docs/

# env template stays local-only (owner preference)
.env.example
*.log
