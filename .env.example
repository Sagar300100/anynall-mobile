# ──────────────────────────────────────────────────────────────────────────────
# Any&All mobile — environment. Copy to `.env` for local dev (gitignored).
#
# EVERYTHING HERE IS PUBLIC. Expo inlines EXPO_PUBLIC_* into the JS bundle, so
# only values safe to ship to clients belong here. The Firebase *web* config is
# public by design — access is controlled by Security Rules + App Check, not by
# hiding these values.
#
# NEVER put secrets here: no Admin SDK service-account JSON, no private keys,
# no Razorpay/API secrets. Those live in Firebase Secret Manager and never
# touch the client. Mirror of the web app's .env.example in bazaarlive-frontend.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend: Cloud Functions HTTP API (no trailing slash) ──
EXPO_PUBLIC_API_URL=https://asia-south1-bazaarlive-78422.cloudfunctions.net/api

# ── Auction engine (live bidding websocket + REST) ──
EXPO_PUBLIC_AUCTION_ENGINE_URL=

# ── Firebase web app config (public) ──
# Firebase Console → Project settings → Your apps → Web app → SDK setup.
# Project is bazaarlive-78422, shared with the website.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=bazaarlive-78422.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=bazaarlive-78422
# NOTE: the only Firebase-linked bucket is *.firebasestorage.app — the legacy
# *.appspot.com name does not exist for this project and silently 404s every
# upload. src/lib/firebase.ts normalises it; do not "correct" it back.
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=bazaarlive-78422.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Google Sign-In ──
# The WEB client ID from Google Cloud Console → Credentials (not the Android
# one). The Android OAuth client must be registered against the debug SHA-1
# from android/app/debug.keystore, which is tracked so every clone shares it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ── Firebase App Check (debug token) ──
# The backend runs APP_CHECK_MODE=enforce, so every API call needs a valid App
# Check token. React Native has no reCAPTCHA v3, so until the EAS dev build
# brings real device attestation (Play Integrity / App Attest), register a
# debug token in Firebase Console → App Check → Debug tokens and paste it here.
# Unset → no header → API calls 401 with APP_CHECK_REQUIRED.
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=
